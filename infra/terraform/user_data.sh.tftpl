#!/bin/bash
# EC2の初回起動時に1回だけ実行されるセットアップ（Terraform の templatefile で値を埋め込む）。
# Docker とアプリ用の docker-compose.yml までを用意する。アプリ本体（app.jar）は後で deploy.ps1 が置く。
#   CloudFront（https）→ 80番 → Spring Boot（app.jar の中の 8080）。画面も API もこれ1つが返す。DBは RDS を使う
# ※ 波かっこ付きの変数（docker compose 用）は、ドル記号を2つ重ねて書く（Terraform を通ると1つになる）
set -euxo pipefail

# Elastic IP の付け替え直後などで通信が一瞬切れても、失敗せずにやり直す
retry() {
  for i in 1 2 3 4 5; do
    "$@" && return 0
    sleep 10
  done
  return 1
}

# メモリ1GBでも Spring Boot が落ちないよう、2GBのスワップを作る
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

retry dnf install -y docker
systemctl enable --now docker

# Amazon Linux 2023 の docker パッケージには compose が入っていないので追加する
mkdir -p /usr/local/lib/docker/cli-plugins
# 版を固定する（latest だと、将来の更新で環境作りが突然失敗することがある）
retry curl -fsSL "https://github.com/docker/compose/releases/download/v5.7.0/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP_DIR=/opt/sns-app
mkdir -p "$APP_DIR"
cd "$APP_DIR"

# DBのパスワードは Parameter Store から読み、このサーバーの root だけが読めるファイルに置く
# （パスワードが起動ログに出ないよう、この間はコマンドの表示を止める）
set +x
DB_PASSWORD=$(retry aws ssm get-parameter --region "${region}" --name "${db_password_parameter}" \
  --with-decryption --query Parameter.Value --output text)
# 確認メールを送る Gmail。まだ登録していなければ空のまま進み、アプリはリンクをログに出す
MAIL_USERNAME=$(aws ssm get-parameter --region "${region}" --name "/${project}/mail/username" \
  --with-decryption --query Parameter.Value --output text 2>/dev/null || true)
MAIL_PASSWORD=$(aws ssm get-parameter --region "${region}" --name "/${project}/mail/password" \
  --with-decryption --query Parameter.Value --output text 2>/dev/null || true)
umask 077
cat > .env <<EOF
DB_PASSWORD=$DB_PASSWORD
ORIGIN_SECRET=${origin_secret}
MAIL_USERNAME=$MAIL_USERNAME
MAIL_PASSWORD=$MAIL_PASSWORD
EOF
umask 022
unset DB_PASSWORD MAIL_USERNAME MAIL_PASSWORD
set -x

cat > docker-compose.yml <<'EOF'
services:
  # app.jar を /opt/sns-app に置いてから `docker compose up -d app` で起動する（deploy.ps1 がやる）
  app:
    image: eclipse-temurin:25-jre
    restart: unless-stopped
    environment:
      DB_URL: jdbc:mysql://${db_host}:3306/${db_name}
      DB_USERNAME: ${db_username}
      DB_PASSWORD: $${DB_PASSWORD}
      TZ: Asia/Tokyo
      # 投稿の画像は S3 に置く（バケットは storage/ の Terraform で作ってある）
      IMAGES_S3_BUCKET: ${images_bucket}
      # ブラウザとは https でつなぐので、ログインの Cookie を https でしか送らないようにする
      SESSION_COOKIE_SECURE: "true"
      # CloudFront からは http で届くので、ブラウザの Origin（https）が別のサイトに見える。同じサイトだと教える
      APP_CORS_ALLOWED_ORIGINS: ${app_origin}
      # API 仕様書（Swagger UI）はローカルだけで使う。ここでは開けないようにする
      API_DOCS_ENABLED: "false"
      # 自分の CloudFront を通ったリクエストだけを受け付ける
      APP_ORIGIN_SECRET: $${ORIGIN_SECRET}
      # 1つの IP から1時間に登録できる回数
      REGISTER_PER_HOUR: "5"
      # 確認メールのリンクの先と、送るのに使う Gmail
      APP_PUBLIC_URL: ${app_origin}
      MAIL_USERNAME: $${MAIL_USERNAME}
      MAIL_PASSWORD: $${MAIL_PASSWORD}
    volumes:
      - ./app.jar:/app/app.jar:ro
    command: ["java", "-Xmx384m", "-Xss512k", "-XX:MaxMetaspaceSize=128m", "-jar", "/app/app.jar"]
    ports:
      - "80:8080"
    mem_limit: 640m
EOF

# アプリより先にイメージを取っておく（デプロイ時にすぐ起動できるように）
retry docker pull eclipse-temurin:25-jre

# 起動直後に AWS への接続が一度失敗すると、SSM エージェントは休止して長いあいだ再接続しない。
# そうなると deploy.ps1 が送れないので、準備の最後にエージェントを起動し直す
systemctl restart amazon-ssm-agent

# 準備が終わった目印。deploy.ps1 はこれができるまで待つ（エージェントの再起動より後に置く）
touch "$APP_DIR/.ready"
